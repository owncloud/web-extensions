# Copy this file to .env and fill in the generated secrets below before
# running `docker compose up -d`. See README.md for the full walkthrough.

# Skips TLS certificate validation between services (Keycloak, jitsi-admin,
# jitsi-admin-proxy) - required because every domain below uses Traefik's
# self-signed certificate. Never set this to true on a real deployment with
# real certificates.
INSECURE=true

# Domains - add all of these to /etc/hosts pointing at 127.0.0.1, see README.md
OCIS_DOMAIN=ocis.owncloud.test
KEYCLOAK_DOMAIN=keycloak.owncloud.test
JITSI_ADMIN_DOMAIN=jitsi.owncloud.test
LIVEKIT_DOMAIN=livekit.owncloud.test
LIVEKIT_MEET_DOMAIN=meet.owncloud.test

# oCIS admin password. Defaults to "admin".
ADMIN_PASSWORD=admin

# Keycloak admin console login (https://keycloak.owncloud.test).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Generated secrets - every one of these MUST be replaced before use. ---
# jitsi-admin's own MariaDB credentials.
#   openssl rand -hex 16
JITSI_ADMIN_DB_PASSWORD=
JITSI_ADMIN_DB_ROOT_PASSWORD=
# Symfony APP_SECRET.
#   openssl rand -hex 16
JITSI_ADMIN_APP_SECRET=
# Must be identical here and inside config/keycloak/jitsiadmin-realm.dist.json's
# <clientsecret> placeholder (docker-entrypoint-override.sh substitutes it in
# at Keycloak startup, reading this same env var) - jitsi-admin and Keycloak
# have to agree on the OAuth client secret.
#   uuidgen
JITSI_ADMIN_OIDC_CLIENT_SECRET=
# Reused for both MERCURE_JWT_SECRET and WEBSOCKET_SECRET.
#   openssl rand -base64 32
JITSI_ADMIN_MERCURE_JWT_SECRET=

# LiveKit API key/secret pair (see LiveKit's own docs - a plain string key and
# a secret at least 32 characters long).
#   LIVEKIT_API_KEY="API$(openssl rand -hex 8)"
#   LIVEKIT_API_SECRET=$(openssl rand -base64 32 | tr -d '=+/' | head -c 40)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Filled in AFTER the stack is up - see README.md "Wiring up jitsi-admin" ---
# The jitsi-admin "Server" API key and identifier the proxy provisions rooms
# against. Room creation will fail with both left blank.
JITSI_ADMIN_API_KEY=
JITSI_ADMIN_SERVER=
