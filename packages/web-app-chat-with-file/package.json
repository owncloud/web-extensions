    "vue3-gettext": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@ownclouders/eslint-config": "12.5.1",
    "@ownclouders/extension-sdk": "12.5.1",
    "@ownclouders/prettier-config": "0.0.2",
    "@ownclouders/tsconfig": "0.0.7",
    "@ownclouders/web-client": "^13.0.0",
    "@ownclouders/web-pkg": "^13.0.0",
    "@types/node": "24.19.2",
    "@vue/test-utils": "^2.6.0",
    "eslint": "9.8.0",
    "happy-dom": "^20.14.5",
    "prettier": "3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "7.2.2",
    "vitest": "4.1.11",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@10.34.1"
